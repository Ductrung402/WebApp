# Template only; Java reads process env. Local launcher can import backend/.env (OS env wins).
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@localhost:5432/EXISTING_DATABASE
JWT_SECRET_KEY=REPLACE_WITH_PRIVATE_RANDOM_VALUE_AT_LEAST_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=REPLACE_WITH_PRIVATE_GEMINI_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
SOCKET_HOST=0.0.0.0
SOCKET_PORT=8001
RUNTIME_DIRECTORY=C:/path/to/EZam/backend/.runtime-java
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://YOUR_FRONTEND_DOMAIN
