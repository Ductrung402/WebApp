# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# DATABASE_URL can override the existing PostgreSQL connection configuration.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/WebApp

# Server-side Gemini credentials only; never use a VITE_ variable for this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
