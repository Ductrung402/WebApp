{
    admin off
    auto_https off
}

:{$PORT:8080} {
    encode gzip
    handle /api/* {
        reverse_proxy {$BACKEND_HTTP_UPSTREAM:backend:8080}
    }
    handle /socket.io/* {
        reverse_proxy {$BACKEND_SOCKET_UPSTREAM:backend:8001}
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
